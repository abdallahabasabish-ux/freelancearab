{
  "name": "freelancearab-functions",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "^15.33.0"
  },
  "scripts": {
    "test": "npm run test:rules && npm run test:integration",
    "test:rules": "firebase emulators:exec --project demo-freelancearab --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:integration": "firebase emulators:exec --project demo-freelancearab --only auth,firestore,functions \"node --test test/quiz.integration.test.js\""
  }
}
